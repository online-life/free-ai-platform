# Non-secret placeholders only.
# Node.js services do not automatically load this file. Load it into each
# service process environment or configure values through a secret manager.
NODE_ENV=development
APP_ENV=local
APP_NAME="Free AI Platform"
APP_URL=http://localhost
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
WEB_HOST=127.0.0.1
WEB_PORT=4173
WEB_ORIGIN=http://127.0.0.1:4173
# Set to the API origin, or empty when a reverse proxy exposes the API same-origin.
API_BASE_URL=http://127.0.0.1:3000
# The API uses this only for first-owner bootstrap. The local installer
# currently requires it each time it runs. Never commit the real value.
BOOTSTRAP_TOKEN=

# PostgreSQL connection used by the API and Prisma.
DATABASE_URL=
# Reserved; Redis and object storage are not consumed by the current app.
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
# Reserved; configure only when a secret-manager integration is implemented.
SECRET_MANAGER_REFERENCE=
# Base64 encoding of exactly 32 random bytes; required for provider-secret encryption.
SECRETS_MASTER_KEY=
SECRETS_KEY_VERSION=v1

# Provider endpoints and credentials are configured through the authenticated
# application. Do not put provider API keys in this file.
