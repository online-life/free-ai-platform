# Non-secret placeholders only.
NODE_ENV=development
APP_ENV=local
APP_NAME=Free AI Platform
APP_URL=http://localhost
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3000
WEB_PORT=4173
WEB_ORIGIN=http://127.0.0.1:4173
# Set to the API origin, or empty when a reverse proxy exposes the API same-origin.
API_BASE_URL=http://127.0.0.1:3000
# Set a unique random value of at least 32 characters for first-owner setup.
# Remove it after bootstrap. Never commit the real value.
BOOTSTRAP_TOKEN=

# Configure only after the relevant architecture decisions are approved.
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
SECRET_MANAGER_REFERENCE=
SECRETS_MASTER_KEY=
SECRETS_KEY_VERSION=v1

# AI provider integrations are intentionally deferred.
