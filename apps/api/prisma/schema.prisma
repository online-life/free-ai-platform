model ProviderConnection {
  id String @id @default(cuid())
  key String
  displayName String
  providerType String
  tenantId String @db.Uuid
  projectId String?
  scopeKey String @default("_")
  baseUrl String
  authenticationType String @default("BEARER")
  credentialId String?
  apiVersion String?
  customHeaders Json @default("{}")
  timeoutMs Int @default(60000)
  maxRetries Int @default(0)
  enabled Boolean @default(false)
  status String @default("DISABLED")
  billingMode String @default("UNKNOWN")
  freeTierStatus String @default("UNKNOWN")
  pricingMetadata Json @default("{}")
  privacyMetadata Json @default("{}")
  metadata Json @default("{}")
  lastSuccessfulTest DateTime?
  lastErrorCode String?
  lastModelSync DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project ProjectWorkspace? @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  credential ProviderCredential? @relation(fields: [tenantId, scopeKey, credentialId], references: [tenantId, scopeKey, id], onDelete: Restrict)
  models ProviderModel[]
  healthChecks ProviderHealth[]
  usage ProviderUsage[]
  @@unique([tenantId, scopeKey, key])
  @@unique([tenantId, id])
  @@index([tenantId, projectId, enabled])
  @@index([status, enabled])
