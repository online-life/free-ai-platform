  project ProjectWorkspace @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@unique([deviceId, projectId])
  @@index([tenantId, projectId])
  @@map("device_project_grants")
}

model LocalRuntimeWorkspace {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid @map("tenant_id")
  deviceId     String   @db.Uuid @map("device_id")
  projectId    String   @map("project_id")
  name         String
  rootAlias    String   @map("root_alias")
  workspaceKey String   @map("workspace_key")
  canRead      Boolean  @default(true) @map("can_read")
  canWrite     Boolean  @default(false) @map("can_write")
  canDelete    Boolean  @default(false) @map("can_delete")
  canExecute   Boolean  @default(false) @map("can_execute")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device  RuntimeDevice    @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Cascade)
  project ProjectWorkspace @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  jobs    RuntimeJob[]

  @@unique([tenantId, deviceId, workspaceKey])
  @@unique([tenantId, id])
  @@index([tenantId, projectId, status])
  @@map("local_runtime_workspaces")
}

model RuntimeJob {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid @map("tenant_id")
  deviceId       String           @db.Uuid @map("device_id")
  projectId      String           @map("project_id")
  workspaceId    String           @db.Uuid @map("workspace_id")
  requestedById  String           @db.Uuid @map("requested_by_id")
  kind           String
  payload        Json
  result         Json?
  errorCode      String?          @map("error_code")
  status         RuntimeJobStatus @default(QUEUED)
  idempotencyKey String?          @map("idempotency_key")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  startedAt      DateTime?        @map("started_at")
  finishedAt     DateTime?        @map("finished_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device    RuntimeDevice         @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Cascade)
  project   ProjectWorkspace      @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)
  workspace LocalRuntimeWorkspace @relation(fields: [tenantId, workspaceId], references: [tenantId, id], onDelete: Cascade)
  requester User                  @relation("RuntimeJobRequester", fields: [tenantId, requestedById], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([deviceId, status, createdAt])
  @@index([tenantId, projectId, createdAt])
  @@map("runtime_jobs")
}

model RuntimeLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  deviceId  String   @db.Uuid @map("device_id")
  event     String
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device RuntimeDevice @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, deviceId, createdAt])
  @@map("runtime_logs")
}
