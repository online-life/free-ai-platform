model RuntimeDevice {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @db.Uuid @map("tenant_id")
  ownerId         String              @db.Uuid @map("owner_id")
  name            String
  operatingSystem String              @map("operating_system")
  architecture    String
  runtimeVersion  String              @map("runtime_version")
  status          RuntimeDeviceStatus @default(PAIRED)
  tokenHash       String              @unique @map("token_hash")
  tokenExpiresAt  DateTime            @map("token_expires_at")
  lastHeartbeatAt DateTime?           @map("last_heartbeat_at")
  revokedAt       DateTime?           @map("revoked_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner      User                    @relation("RuntimeDeviceOwner", fields: [tenantId, ownerId], references: [tenantId, id], onDelete: Cascade)
  workspaces LocalRuntimeWorkspace[]
  projects   DeviceProjectGrant[]
  jobs       RuntimeJob[]
  logs       RuntimeLog[]

  @@unique([tenantId, id])
  @@index([tenantId, ownerId, status])
  @@index([status, lastHeartbeatAt])
  @@map("runtime_devices")
}

model DeviceProjectGrant {
  id        String   @id @default(uuid()) @db.Uuid
